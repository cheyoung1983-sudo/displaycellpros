# AI_GATEWAY_API_KEY: Vercel AI Gateway key, used by api/chat and api/triage
# (both routed to Alibaba Cloud Qwen3 models). Get one from the Vercel
# dashboard -> AI Gateway -> API Keys. Only needed for local dev; in
# production on Vercel with AI Gateway enabled on the project, VERCEL_OIDC_TOKEN
# is supplied automatically and this can be left blank.
AI_GATEWAY_API_KEY=

# APP_URL: the URL where this app is hosted.
APP_URL=

# APP_BASE_URL: used by @auth0/nextjs-auth0 v4 (renamed from v3's AUTH0_BASE_URL).
APP_BASE_URL=

# AUTH0_DOMAIN: your Auth0 tenant domain, no scheme (e.g. example.us.auth0.com).
# Renamed from v3's AUTH0_ISSUER_BASE_URL.
AUTH0_DOMAIN=
AUTH0_CLIENT_ID=
AUTH0_CLIENT_SECRET=
# AUTH0_SECRET: a long, random string used to encrypt the session cookie.
AUTH0_SECRET=

AWS_ACCOUNT_ID=
AWS_REGION=
AWS_RESOURCE_ARN=
AWS_ROLE_ARN=

# GEMINI_API_KEY: legacy - only read by the excluded server.ts (legacy Vite/
# Express app, not part of the deployed Next.js app). Not used by any live route.
GEMINI_API_KEY=

PGDATABASE=
PGHOST=
PGHOST_READ_ONLY=
PGPORT=
PGSSLMODE=
PGUSER=
PG_CONNECTION_TIMEOUT_MS=
PG_IDLE_TIMEOUT_MS=
PG_MAX_POOL=
PG_MAX_USES=
PG_RO_MAX_POOL=
PG_STATEMENT_TIMEOUT_MS=
RECAPTCHA_SITE_KEY=
SHOPIFY_ADMIN_API_TOKEN=
SHOPIFY_STOREFRONT_ACCESS_TOKEN=
SHOPIFY_STORE_DOMAIN=
