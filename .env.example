# Environment Variables
RECAPTCHA_SITE_KEY="6LcB60UtAAAAAEk-ADlBMnuUjbWXddXTyXLcmoSj"

# AI_GATEWAY_API_KEY: Vercel AI Gateway key, used by api/chat and api/triage
# (both routed to Alibaba Cloud Qwen3 models). Get one from the Vercel
# dashboard -> AI Gateway -> API Keys. Only needed for local dev; in
# production on Vercel with AI Gateway enabled on the project, VERCEL_OIDC_TOKEN
# is supplied automatically and this can be left blank.
AI_GATEWAY_API_KEY=""

# GEMINI_API_KEY: legacy - only read by the excluded server.ts (legacy Vite/
# Express app, not part of the deployed Next.js app). Not used by any live route.
GEMINI_API_KEY=""

# SHOPIFY Configuration
SHOPIFY_STORE_DOMAIN="vercel-store-34d604b7-q6ui4f53.myshopify.com"
SHOPIFY_STOREFRONT_ACCESS_TOKEN="cda195dfcf9e55984c840562aaeafa85"
SHOPIFY_ADMIN_API_TOKEN=""

# APP_URL: The URL where this applet is hosted.
APP_URL="http://localhost:3000"

# AWS Aurora PostgreSQL Configuration
AWS_ACCOUNT_ID="595710543826"
AWS_REGION="us-east-1"
AWS_RESOURCE_ARN="arn:aws:rds:us-east-1:595710543826:cluster:dcp-production-db"
AWS_ROLE_ARN="arn:aws:iam::595710543826:role/Vercel/access-dcp-production-db"
PGDATABASE="postgres"
PGHOST="dcp-production-db.cluster-cs7wcksg2js1.us-east-1.rds.amazonaws.com"
PGHOST_READ_ONLY="dcp-production-db.cluster-ro-cs7wcksg2js1.us-east-1.rds.amazonaws.com"
PGPORT="5432"
PGSSLMODE="require"
PGUSER="postgres"

# High-Concurrency Connection Pooling Parameters (Optional Tuning)
PG_MAX_POOL="25"
PG_RO_MAX_POOL="35"
PG_IDLE_TIMEOUT_MS="30000"
PG_CONNECTION_TIMEOUT_MS="3500"
PG_STATEMENT_TIMEOUT_MS="5000"
PG_MAX_USES="7500"
