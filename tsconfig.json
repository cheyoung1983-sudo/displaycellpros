{
  "compilerOptions": {
    "target": "ES2022",
    "lib": [
      "dom",
      "dom.iterable",
      "esnext"
    ],
    "allowJs": true,
    "skipLibCheck": true,
    "strict": true,
    "noEmit": true,
    "allowImportingTsExtensions": true,
    "esModuleInterop": true,
    "module": "esnext",
    "moduleResolution": "bundler",
    "resolveJsonModule": true,
    "isolatedModules": true,
    "jsx": "preserve",
    "incremental": true,
    "plugins": [
      {
        "name": "next"
      }
    ],
    "paths": {
      "@/*": [
        "./src/*"
      ]
    }
  },
  "include": [
    "src/**/*.ts",
    "src/**/*.tsx",
    "next-env.d.ts",
    ".next/types/**/*.ts"
  ],
  "exclude": [
    "node_modules",
    "netlify",
    "index.ts",
    "scripts",
    "api",
    "server.ts",
    "dist",
    "src/App.tsx",
    "src/main.tsx",
    "src/registerServiceWorker.ts",
    "src/lib/stripe.ts",
    "src/components/Checkout.tsx",
    "src/components/StripeCheckoutModal.tsx",
    "src/components/Auth0ProviderWithConfig.tsx",
    "src/components/AboutUs.tsx",
    "src/components/FounderMessage.tsx",
    "src/components/LiveTechnicianChat.tsx",
    "src/components/ContactSupport.tsx",
    "src/components/Auth0FlowsHub.tsx",
    "src/components/IntakeForm.tsx",
    "src/components/RepairStatusTracker.tsx",
    "src/components/ClientProfileRepairOrders.tsx",
    "src/components/QRScannerModal.tsx",
    "src/components/QrScannerModal.tsx",
    "src/components/UserProfile.tsx",
    "src/components/Auth0RbacModal.tsx",
    "src/components/Auth0UserButton.tsx",
    "src/components/RepairEstimateCalculator.tsx"
  ]
}
